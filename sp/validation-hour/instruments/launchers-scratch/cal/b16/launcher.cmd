"C:\Program Files\nodejs\node.exe" C:\Users\sotka\AppData\Local\Temp\claude\C-407A~1\9C5886~1\SCRATC~1\VALIDA~1\INSTRU~1\LAUNCH~1\cal\b16\stub\stub-run.mjs app:start >> electron\test\golden\interview60.runs\flight-h40d-prestart.launcher.log 2>&1
